{
  "name": "seo-crawl-audit-workspace",
  "version": "0.5.0",
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*"
  ],
  "scripts": {
    "build": "tsc -b && npm run bundle --workspace seo-crawl-audit && npm run bundle --workspace @seo-crawl-audit/action",
    "clean": "tsc -b --clean",
    "test": "npm run build && node --test",
    "check": "npm run build && node --test && npm run pack:check",
    "pack:check": "npm pack --workspace seo-crawl-audit --dry-run",
    "benchmark:10k": "npm run build && node scripts/benchmark-10k.mjs",
    "demo:generate": "npm run build && node scripts/generate-demo.mjs",
    "seo-audit": "node bin/seo-audit.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "esbuild": "^0.25.0",
    "typescript": "^5.9.0"
  }
}
