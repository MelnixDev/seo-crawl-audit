{
  "name": "@seo-crawl-audit/core",
  "version": "0.7.1",
  "description": "Local-first SEO crawling, audit, diff, snapshot, and report engine.",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
