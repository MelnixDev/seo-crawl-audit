{
  "name": "@seo-crawl-audit/mcp",
  "version": "0.9.0",
  "private": true,
  "description": "Local stdio MCP adapter for SEO Crawl Audit.",
  "type": "module",
  "main": "dist/stdio.js",
  "scripts": {
    "build": "tsc -b",
    "bundle": "esbuild dist/stdio.js --bundle --platform=node --target=node20 --format=esm --minify-whitespace --minify-syntax --outfile=../cli/bundle/mcp.js"
  },
  "engines": {
    "node": ">=20.19"
  },
  "dependencies": {
    "@modelcontextprotocol/server": "^2.0.0",
    "@seo-crawl-audit/core": "0.9.0",
    "zod": "^4.0.0"
  }
}
